<Window x:Class="PolMedUMG.View.AdminScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PolMedUMG.View"
             mc:Ignorable="d" 
             Title="Panel administracyjny" Height="540" Width="960"
             WindowStyle="None"
             ResizeMode="NoResize"
             MouseDown="Window_MouseDown"
             WindowStartupLocation="CenterScreen">
    <Grid>
        <TextBlock Height="16" Margin="0,90,0,0" TextWrapping="Wrap" Text="Nazwa użytkownika" VerticalAlignment="Top" Width="120" HorizontalAlignment="Center"/>
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"  x:Name="txtUserName" HorizontalAlignment="Center" Margin="0,110,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="120"/>
        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" x:Name="txtUserPwd" HorizontalAlignment="Center" Margin="0,150,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="120"/>
        <TextBlock HorizontalAlignment="Center" Height="16" Margin="0,130,0,0" TextWrapping="Wrap" Text="Hasło użytkownika" VerticalAlignment="Top" Width="120"/>
        <Button Command="{Binding PasswordAdd}" x:Name="btnChangePassword" Content="Ustaw" HorizontalAlignment="Center" Margin="0,180,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>





     