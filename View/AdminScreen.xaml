<Window x:Class="PolMedUMG.View.AdminScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
        xmlns:local="clr-namespace:PolMedUMG.View"
        mc:Ignorable="d" 
        Title="Panel administracyjny" Height="700" Width="1080"
        WindowStyle="None"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Kolumny z większą przestrzenią w środku -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Wiersze dla poszczególnych sekcji -->
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>

        </Grid.RowDefinitions>

        <!-- Przyciski kontrolne (minimalizuj, maksymalizuj, zamknij) -->
        <Grid Grid.Column="3" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnMinimize" Click="btnMinimize_Click" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFB1B1B1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE2E2E2" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="35" Height="20" CornerRadius="3" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <fa:ImageAwesome Icon="WindowMinimize" Margin="7"/>
            </Button>

            <Button x:Name="btnFullScreen" Grid.Column="1" Click="btnMinimize_FullScreen" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFB1B1B1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE2E2E2" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="35" Height="20" CornerRadius="3" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <fa:ImageAwesome Icon="WindowMaximize" Margin="3"/>
            </Button>

            <Button x:Name="btnClose" Grid.Column="2" Click="btnMinimize_Close" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFB1B1B1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE2E2E2" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="35" Height="20" CornerRadius="3" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <fa:ImageAwesome Icon="Close" Margin="3"/>
            </Button>
        </Grid>

        <!-- Zmień hasło użytkownika -->
        <StackPanel Grid.Column="0" Grid.Row="1" Margin="10,40,10,0" VerticalAlignment="Top">
            <TextBlock Text="Zmień hasło użytkownika" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,10" FontWeight="Bold"/>
            <TextBlock Text="Nazwa użytkownika" HorizontalAlignment="Center"/>
            <TextBox Text="{Binding UsernameChange}" Width="150" Margin="0,2,0,6"/>
            <TextBlock Text="Hasło użytkownika" HorizontalAlignment="Center"/>
            <TextBox Text="{Binding PasswordChange}" Width="150" Margin="0,2,0,10"/>
            <Button Content="Zmień" Command="{Binding PasswordAddFunc}" Width="100" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Usuń użytkownika -->
        <StackPanel Grid.Column="0" Grid.Row="2" Margin="10,80,10,0" VerticalAlignment="Top">
            <TextBlock Text="Usuń pacjenta" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,10" FontWeight="Bold"/>
            <TextBlock Text="Nazwa pacjenta" HorizontalAlignment="Center" />
            <TextBox Text="{Binding UserRemove}" Width="150" Margin="0,2,0,10"/>
            <Button Content="Zmień" Command="{Binding RemoveUserFunc}" Width="100" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Dodaj lekarza -->
        <StackPanel Grid.Column="3" Grid.Row="1" Margin="20,40,20,20" VerticalAlignment="Top" HorizontalAlignment="Stretch">
            <TextBlock Text="Dodaj lekarza" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,10" FontWeight="Bold"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Lewa kolumna -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Imię"/>
                    <TextBox Text="{Binding DoctorFirstName}" Margin="0,2,0,6" />
                    <TextBlock Text="Nazwisko"/>
                    <TextBox Text="{Binding DoctorLastName}" Margin="0,2,0,6" />
                    <TextBlock Text="Email"/>
                    <TextBox Text="{Binding DoctorEmail}" Margin="0,2,0,6" />
                    <TextBlock Text="Hasło"/>
                    <TextBox Text="{Binding DoctorPassword}" Margin="0,2,0,6" />
                </StackPanel>

                <!-- Prawa kolumna -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Nazwa użytkownika"/>
                    <TextBox Text="{Binding DoctorUsername}" Margin="0,2,0,6" />
                    <TextBlock Text="Telefon"/>
                    <TextBox Text="{Binding DoctorPhone}" Margin="0,2,0,6" />
                    <TextBlock Text="Specjalizacja"/>
                    <TextBox Text="{Binding DoctorSpecialty}" Margin="0,2,0,6" />
                    <TextBlock Text="Numer gabinetu"/>
                    <TextBox Text="{Binding DoctorOffice}" Margin="0,2,0,12" />
                </StackPanel>
            </Grid>
            <Button Content="Dodaj" Command="{Binding AddDoctorFunc}" Width="120" Height="32" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Usuń lekarza -->
        <StackPanel Grid.Column="3" Grid.Row="2" Margin="0,80,0,0" VerticalAlignment="Top" HorizontalAlignment="Center">
            <TextBlock Text="Usuń lekarza" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,10" FontWeight="Bold"/>
            <TextBlock Text="Nazwa lekarza" HorizontalAlignment="Center"/>
            <TextBox x:Name="RemoveDoctorTxt" Text="{Binding DoctorToRemove}" Width="150" Margin="0,2,0,10"/>
            <Button Content="Usuń" Command="{Binding RemoveDoctorFunc}" Width="100" HorizontalAlignment="Center"/>
        </StackPanel>

        <Grid Margin="10" Grid.Column="1" Grid.Row="1" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Title -->
            <TextBlock
               FontSize="20"
               Grid.ColumnSpan="4"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,0,0,15">
        <Run Language="pl-pl" Text="Lista lekarzy"/>
            </TextBlock>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="4">
                <!-- Headings -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.ColumnSpan="4">
                    <TextBlock Text="ID"  TextAlignment="Left" Margin="40,0,0,0" Width="20"  FontWeight="Bold" Grid.Column="0"/>
                    <TextBlock Text="E-Mail"  TextAlignment="Left"  Margin="100,0,00,0" Width="40"  FontWeight="Bold" Grid.Column="1"/>
                    <TextBlock Text="Imię"  TextAlignment="Left" Margin="120,0,00,0" Width="40"  FontWeight="Bold" Grid.Column="2"/>
                    <TextBlock Text="Nazwisko" TextAlignment="Left" Margin="60,0,00,0"  Width="60" FontWeight="Bold" Grid.Column="3"/>
                </StackPanel>

                <!-- Doctors -->
                <ListBox x:Name="ResultsListBox"
                 Background="Transparent"
                 BorderBrush="Transparent"
                 BorderThickness="0"
                 Padding="6"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1"
                                    BorderBrush="AliceBlue"
                          Margin="0,-2"
                          Padding="5,5,0,5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding DoctorUid}"
                                       HorizontalAlignment="Center"
                                       Foreground="Black"
                                       TextAlignment="Center"
                                       Grid.Column="0"
                                       Width="110"
                                       FontSize="10.5"
                                       Margin="0,0,0,0"/>
                                    <TextBlock Text="{Binding DoctorMail}" 
                                       Foreground="Black"
                                       Margin="10,0,20,0"
                                       TextAlignment="Center"
                                       Grid.Column="1"
                                       Width="165"
                                       HorizontalAlignment="Center"
                                       FontSize="10.5"/>
                                    <TextBlock Text="{Binding DoctorFirstName}" 
                                        Foreground="Black"
                                        Margin="10,0,10,0"
                                        TextAlignment="Center"       
                                        Grid.Column="2"
                                        Width="60"
                                        HorizontalAlignment="Center"
                                        FontSize="10.5"/>
                                    <TextBlock Text="{Binding DoctorSecondName}" 
                                        Foreground="Black"
                                        Margin="10,0,0,0"
                                        TextAlignment="Center"       
                                        Grid.Column="3"
                                        Width="60"
                                        HorizontalAlignment="Center"
                                        FontSize="10.5"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,5"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>

            <!-- Pages -->
            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="◀" 
                Width="30" Height="30" 
                Margin="10,0" 
                Background="Transparent" 
                BorderBrush="Transparent"
                Foreground="#476EFF"
                FontSize="18"
                Click="PrevPage_Click"/>

                <Border Background="#8093FF"
                CornerRadius="10"
                Padding="5,2"
                Margin="5,0">
                    <TextBlock x:Name="PageCounterText"
                       Text="1/1"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                </Border>

                <Button Content="▶" 
                Width="30" Height="30" 
                Margin="10,0" 
                Background="Transparent" 
                BorderBrush="Transparent"
                Foreground="#476EFF"
                FontSize="18"
                Click="NextPage_Click"/>
            </StackPanel>
        </Grid>

        <Grid Margin="10" Grid.Column="1" Grid.Row="2" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Title -->
            <TextBlock
               FontSize="20"
               Grid.ColumnSpan="4"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,0,0,15">
        <Run Language="pl-pl" Text="Lista pacjentów"/>
            </TextBlock>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="4">
                <!-- Headings -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.ColumnSpan="4">
                    <TextBlock Text="ID"  TextAlignment="Left" Margin="40,0,0,0" Width="20"  FontWeight="Bold" Grid.Column="0"/>
                    <TextBlock Text="E-Mail"  TextAlignment="Left"  Margin="100,0,00,0" Width="40"  FontWeight="Bold" Grid.Column="1"/>
                    <TextBlock Text="Imię"  TextAlignment="Left" Margin="120,0,00,0" Width="40"  FontWeight="Bold" Grid.Column="2"/>
                    <TextBlock Text="Nazwisko" TextAlignment="Left" Margin="60,0,00,0"  Width="60" FontWeight="Bold" Grid.Column="3"/>
                </StackPanel>

                <!-- Patients -->
                <ListBox x:Name="ListBoxPatients"
                 Background="Transparent"
                 BorderBrush="Transparent"
                 BorderThickness="0"
                 Padding="6"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1"
                                    BorderBrush="AliceBlue"
                          Margin="0,-2"
                          Padding="5,5,0,5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding PatientUid}"
                                       HorizontalAlignment="Center"
                                       Foreground="Black"
                                       TextAlignment="Center"
                                       Grid.Column="0"
                                       Width="110"
                                       FontSize="10.5"
                                       Margin="0,0,0,0"/>
                                    <TextBlock Text="{Binding PatientMail}" 
                                       Foreground="Black"
                                       Margin="10,0,20,0"
                                       TextAlignment="Center"
                                       Grid.Column="1"
                                       Width="165"
                                       HorizontalAlignment="Center"
                                       FontSize="10.5"/>
                                    <TextBlock Text="{Binding PatientFirstName}" 
                                        Foreground="Black"
                                        Margin="10,0,10,0"
                                        TextAlignment="Center"       
                                        Grid.Column="2"
                                        Width="60"
                                        HorizontalAlignment="Center"
                                        FontSize="10.5"/>
                                    <TextBlock Text="{Binding PatientSecondName}" 
                                        Foreground="Black"
                                        Margin="10,0,0,0"
                                        TextAlignment="Center"       
                                        Grid.Column="3"
                                        Width="60"
                                        HorizontalAlignment="Center"
                                        FontSize="10.5"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,5"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>

            <!-- Pages -->
            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="◀" 
                Width="30" Height="30" 
                Margin="10,0" 
                Background="Transparent" 
                BorderBrush="Transparent"
                Foreground="#476EFF"
                FontSize="18"
                Click="PrevPage_ClickPatient"/>

                <Border Background="#8093FF"
                CornerRadius="10"
                Padding="5,2"
                Margin="5,0">
                    <TextBlock x:Name="PageCounterTextPatients"
                       Text="1/1"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                </Border>

                <Button Content="▶" 
                Width="30" Height="30" 
                Margin="10,0" 
                Background="Transparent" 
                BorderBrush="Transparent"
                Foreground="#476EFF"
                FontSize="18"
                Click="NextPage_ClickPatient"/>
            </StackPanel>
        </Grid>
        <Button Grid.Column="1" Content="Odswież stronę" HorizontalAlignment="Center" Grid.Row="3" VerticalAlignment="Center" Click="ReloadPage"/>



    </Grid>
</Window>
