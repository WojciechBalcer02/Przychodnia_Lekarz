<Window x:Class="PolMedUMG.View.AdminScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
        xmlns:local="clr-namespace:PolMedUMG.View"
        mc:Ignorable="d" 
        Title="Panel administracyjny" Height="600" Width="1080"
        WindowStyle="None"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <!-- Kolumny z większą przestrzenią w środku -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <!-- Wiersze dla poszczególnych sekcji -->
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Przyciski kontrolne (minimalizuj, maksymalizuj, zamknij) -->
        <Grid Grid.Column="3" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnMinimize" Click="btnMinimize_Click" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFB1B1B1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE2E2E2" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="35" Height="20" CornerRadius="3" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <fa:ImageAwesome Icon="WindowMinimize" Margin="7"/>
            </Button>

            <Button x:Name="btnFullScreen" Grid.Column="1" Click="btnMinimize_FullScreen" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFB1B1B1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE2E2E2" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="35" Height="20" CornerRadius="3" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <fa:ImageAwesome Icon="WindowMaximize" Margin="3"/>
            </Button>

            <Button x:Name="btnClose" Grid.Column="2" Click="btnMinimize_Close" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFB1B1B1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE2E2E2" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="35" Height="20" CornerRadius="3" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <fa:ImageAwesome Icon="Close" Margin="3"/>
            </Button>
        </Grid>

        <!-- Zmień hasło użytkownika -->
        <StackPanel Grid.Column="0" Grid.Row="1" Margin="20,60,20,0" VerticalAlignment="Top">
            <TextBlock Text="Zmień hasło użytkownika" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Nazwa użytkownika"/>
            <TextBox Text="{Binding UsernameChange}" Width="150" Margin="0,2,0,6"/>
            <TextBlock Text="Hasło użytkownika"/>
            <TextBox Text="{Binding PasswordChange}" Width="150" Margin="0,2,0,10"/>
            <Button Content="Zmień" Command="{Binding PasswordAddFunc}" Width="100" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Usuń użytkownika -->
        <StackPanel Grid.Column="0" Grid.Row="2" Margin="20,60,20,0" VerticalAlignment="Top">
            <TextBlock Text="Usuń użytkownika" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Nazwa użytkownika"/>
            <TextBox Text="{Binding UserRemove}" Width="150" Margin="0,2,0,10"/>
            <Button Content="Zmień" Command="{Binding RemoveUserFunc}" Width="100" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Dodaj lekarza -->
<StackPanel Grid.Column="1" Grid.Row="1" Margin="30,60,30,20" VerticalAlignment="Top" HorizontalAlignment="Stretch">
    <TextBlock Text="Dodaj lekarza" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,10"/>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Lewa kolumna -->
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Imię"/>
            <TextBox Text="{Binding DoctorFirstName}" Margin="0,2,0,6" />
            <TextBlock Text="Nazwisko"/>
            <TextBox Text="{Binding DoctorLastName}" Margin="0,2,0,6" />
            <TextBlock Text="Email"/>
            <TextBox Text="{Binding DoctorEmail}" Margin="0,2,0,6" />
            <TextBlock Text="Hasło"/>
            <TextBox Text="{Binding DoctorPassword}" Margin="0,2,0,6" />
        </StackPanel>

        <!-- Prawa kolumna -->
        <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Nazwa użytkownika"/>
            <TextBox Text="{Binding DoctorUsername}" Margin="0,2,0,6" />
            <TextBlock Text="Telefon"/>
            <TextBox Text="{Binding DoctorPhone}" Margin="0,2,0,6" />
            <TextBlock Text="Specjalizacja"/>
            <TextBox Text="{Binding DoctorSpecialty}" Margin="0,2,0,6" />
            <TextBlock Text="Numer gabinetu"/>
            <TextBox Text="{Binding DoctorOfficeNumber}" Margin="0,2,0,12" />
        </StackPanel>
    </Grid>
    <Button Content="Dodaj" Command="{Binding AddDoctorFunc}" Width="120" Height="32" HorizontalAlignment="Center" Margin="0,20,0,0"/>
</StackPanel>




        <!-- Usuń lekarza -->
        <StackPanel Grid.Column="1" Grid.Row="2" Margin="0,60,0,0" VerticalAlignment="Top" HorizontalAlignment="Center">
            <TextBlock Text="Usuń lekarza" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Nazwa użytkownika"/>
            <TextBox Text="{Binding DoctorToRemove}" Width="150" Margin="0,2,0,10"/>
            <Button Content="Usuń" Command="{Binding RemoveDoctorFunc}" Width="100" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
