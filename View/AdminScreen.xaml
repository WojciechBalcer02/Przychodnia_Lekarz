<Window x:Class="PolMedUMG.View.AdminScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
             xmlns:local="clr-namespace:PolMedUMG.View"
             mc:Ignorable="d" 
             Title="Panel administracyjny" Height="540" Width="960"
             WindowStyle="None"
             ResizeMode="NoResize"
             MouseDown="Window_MouseDown"
             WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Column="3" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnMinimize"
    BorderThickness="7,0,0,0"
    Foreground="White"
    FontSize="18"
    FontFamily="Century Gothic"
    Cursor="Hand"
    Click="btnMinimize_Click">


                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFB1B1B1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE2E2E2" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="35" Height="20" CornerRadius="3" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

                <fa:ImageAwesome Icon="WindowMinimize" Margin="7"/>

            </Button>
            <Button x:Name="btnFullScreen"
BorderThickness="0"
Foreground="White"
FontSize="18"
FontFamily="Century Gothic"
Cursor="Hand"
Click="btnMinimize_FullScreen" Grid.Column="1"
>

                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFB1B1B1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE2E2E2" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="35" Height="20" CornerRadius="3" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

                <fa:ImageAwesome Icon="WindowMaximize" Margin="3"/>


            </Button>
            <Button x:Name="btnClose"
BorderThickness="0"
Foreground="White"
FontSize="18"
FontFamily="Century Gothic"
Cursor="Hand"
Click="btnMinimize_Close" Margin="0,0,0,0" Grid.Column="2">


                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFB1B1B1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE2E2E2" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="35" Height="20" CornerRadius="3" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

                <fa:ImageAwesome Icon="Close" Margin="3"/>

            </Button>

        </Grid>
        <Grid/>

        <TextBlock HorizontalAlignment="Center" Margin="0,69,0,0" Grid.Row="1" TextWrapping="Wrap" Text="Zmień hasło użytkownika" VerticalAlignment="Top" FontSize="14"/>
        <TextBlock Height="16" Margin="0,90,0,0" TextWrapping="Wrap" Text="Nazwa użytkownika" VerticalAlignment="Top" Width="120" HorizontalAlignment="Center" Grid.Row="1"/>
        <TextBox Text="{Binding UsernameChange, UpdateSourceTrigger=PropertyChanged}"  x:Name="txtUserName" HorizontalAlignment="Center" Margin="0,110,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="120" Grid.Row="1"/>
        <TextBox Text="{Binding PasswordChange, UpdateSourceTrigger=PropertyChanged}" x:Name="txtUserPwd" HorizontalAlignment="Center" Margin="0,150,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="120" Grid.Row="1"/>
        <TextBlock HorizontalAlignment="Center" Height="16" Margin="0,130,0,0" TextWrapping="Wrap" Text="Hasło użytkownika" VerticalAlignment="Top" Width="120" Grid.Row="1"/>
        <Button Command="{Binding PasswordAddFunc}" x:Name="btnChangePassword" Content="Zmień" HorizontalAlignment="Center" Margin="0,180,0,0" VerticalAlignment="Top" Grid.Row="1"/>

        <TextBlock HorizontalAlignment="Center" Margin="0,69,0,0" Grid.Row="2" TextWrapping="Wrap" Text="Usuń użytkownika" VerticalAlignment="Top" FontSize="14"/>
        <TextBlock Height="16" TextWrapping="Wrap" Text="Nazwa użytkownika" VerticalAlignment="Top" Width="120" HorizontalAlignment="Center" Grid.Row="2" Margin="0,90,0,0"/>
        <TextBox Text="{Binding UserRemove, UpdateSourceTrigger=PropertyChanged}"  x:Name="txtRemoveUser" HorizontalAlignment="Center" Margin="0,110,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="120" Grid.Row="2"/>
        <Button Command="{Binding RemoveUserFunc}" x:Name="btnRemoveUser" Content="Zmień" HorizontalAlignment="Center" Margin="0,140,0,0" VerticalAlignment="Top" Grid.Row="2"/>


    </Grid>
</Window>





     