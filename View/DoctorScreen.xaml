<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="clr-namespace:PolMedUMG.View"
        xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
        xmlns:ViewModel="clr-namespace:PolMedUMG.ViewModel" x:Class="PolMedUMG.View.DoctorScreen"
        Title="Panel lekarza" Height="720" Width="1280"
        WindowStyle="None"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <DockPanel Grid.Row="0" Grid.RowSpan="2" Background="White">

            <!-- Logo -->
            <Image Source="{StaticResource di_PolMedLOGO}"
                 Height="80"
                 Margin="10"
                 DockPanel.Dock="Top"
                 Stretch="Uniform"/>

            <!-- Navigation List -->
            <ListBox x:Name="NavList"
               DockPanel.Dock="Top"
               Background="Transparent"
               BorderThickness="0"
               SelectionMode="Single"
               Margin="0,10,0,0"
               SelectedIndex="0"
               SelectionChanged="MyListBox_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Border x:Name="Border"
                            BorderThickness="0,0,0,2"
                            CornerRadius="6"
                            BorderBrush="LightGray"
                            Background="Transparent"
                            Padding="20,16">
                                        <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#D3D3D3"/>
                                            <Setter TargetName="Border" Property="BorderBrush" Value="Black"/>
                                            <Setter TargetName="Border" Property="BorderThickness" Value="2,0,0,2"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#D3D3D3"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <!-- Your menu items -->
                <ListBoxItem Content="Strona główna"/>
                <ListBoxItem Content="Umów wizytę"/>
                <ListBoxItem Content="Kalendarz"/>
                <ListBoxItem Content="Cennik usług"/>
                <ListBoxItem Content="Wiadomości"/>
                <ListBoxItem Content="Ustawienia konta"/>
            </ListBox>

        </DockPanel>

        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>


            <Button x:Name="btnMinimize"
    BorderThickness="7,0,0,0"
    Foreground="White"
    FontSize="18"
    FontFamily="Century Gothic"
    Cursor="Hand"
    Grid.Column="1"
    Click="btnMinimize_Click">


                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFB1B1B1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE2E2E2" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="35" Height="20" CornerRadius="3" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

                <fa:ImageAwesome Icon="WindowMinimize" Margin="7"/>

            </Button>
            <Button x:Name="btnFullScreen"
BorderThickness="0"
Foreground="White"
FontSize="18"
FontFamily="Century Gothic"
Cursor="Hand"
Grid.Column="2"
Click="btnMinimize_FullScreen"
>

                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFB1B1B1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE2E2E2" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="35" Height="20" CornerRadius="3" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

                <fa:ImageAwesome Icon="WindowMaximize" Margin="3"/>


            </Button>
            <Button x:Name="btnClose"
BorderThickness="0"
Foreground="White"
FontSize="18"
FontFamily="Century Gothic"
Cursor="Hand"
Grid.Column="3"
Click="btnMinimize_Close">


                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFB1B1B1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE2E2E2" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="35" Height="20" CornerRadius="3" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

                <fa:ImageAwesome Icon="Close" Margin="3"/>

            </Button>
        </Grid>

        <!-- RIGHT CONTENT AREA -->
        <DockPanel 
            x:Name="RightContentPanel"
            Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center">
            <view:dMainView DockPanel.Dock="Bottom"  VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </DockPanel>


        <TextBlock  Text="Zalogowano jako:"
                FontSize="14"
                FontWeight="Bold"
                Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" Panel.ZIndex="1" Grid.Row="2" Margin="5,0,0,0"/>

        <Border Background="DarkGray" Padding="10" Grid.Row="2" Grid.ColumnSpan="2">
            <TextBlock  Text=""
                x:Name="txtblckUserName"
                FontSize="14"
                FontWeight="Bold"
                Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-4,0,0"/>
        </Border>



    </Grid>

</Window>