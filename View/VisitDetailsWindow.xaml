<Window x:Class="PolMedUMG.View.VisitDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Szczegóły wizyty"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="650"
        Height="700"
        WindowStartupLocation="CenterScreen">

        <!-- Background -->

        <Border Width="550"
                Height="650"
                Background="White"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="20,30,30,10">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5"/>
            </Border.Effect>

            <Grid>
                <!-- Close button -->
                <Button Content="✕"
                        Width="30" Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="Black"
                        FontSize="16"
                        Click="CloseButton_Click"/>

                <!-- Logo -->
                <Image Source="{StaticResource di_PolMedLOGO}"
                 Width="60"
                 Height="70"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,0,30,0"/>

                <!-- Under logo -->
                <Separator HorizontalAlignment="Stretch"
                           VerticalAlignment="Top"
                           Margin="0,60,0,0"
                           Height="1"
                           Background="Gray"/>

                <!-- Info -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="DateOfVisitText" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="DoctorName" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="RoomNumber" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="CauseOfVisitText" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="DescriptionText" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
            </StackPanel>
            </Grid>
        </Border>
</Window>
