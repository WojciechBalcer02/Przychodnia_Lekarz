<Window x:Class="PolMedUMG.View.dMainViewDoctor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolMedUMG.View"
        mc:Ignorable="d"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="NoResize"
        Title="Informacje lekarza"  Width="800" Height="600" WindowStartupLocation="CenterScreen">
    <Border Width="700"
            Height="500"
            Background="White"
            CornerRadius="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="30">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5"/>
        </Border.Effect>

        <Grid>
            <!-- Close button -->
            <Button Content="✕"
                    Width="30" Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="Black"
                    FontSize="16"
                    Click="CloseButton_Click"/>


            <!-- Logo -->
            <Image Source="{StaticResource di_PolMedLOGO}"
             Width="60"
             Height="60"
             HorizontalAlignment="Right"
             VerticalAlignment="Top"
             Margin="0,0,30,0"/>

            <!-- Under logo -->
            <Separator HorizontalAlignment="Stretch"
                       VerticalAlignment="Top"
                       Margin="0,70,0,0"
                       Height="1"
                       Background="Gray"/>



            <!-- Info -->
            <Grid Height="350" Width="auto" Margin="5,70,5,10">
                <Image HorizontalAlignment="Left" Height="100" Margin="10,5,0,0" VerticalAlignment="Top" Width="100" Source="/Images/Icons/profile.jpg"/>
                <TextBlock FontSize="15" x:Name="DoctorNameText" HorizontalAlignment="Left" Margin="10,120,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                <TextBlock FontSize="15" x:Name="DoctorSurnameText" HorizontalAlignment="Left" Margin="10,150,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                <TextBlock FontSize="15" x:Name="DoctorEmailText" HorizontalAlignment="Left" Margin="10,180,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                <TextBlock FontSize="15" x:Name="DoctorRoomNumberText" HorizontalAlignment="Left" Margin="10,210,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                <TextBlock FontSize="15" x:Name="DoctorPhoneNumberText" HorizontalAlignment="Left" Margin="10,240,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
            </Grid>
        </Grid>
    </Border>
</Window>
