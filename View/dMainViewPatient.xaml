<Window x:Class="PolMedUMG.View.dMainViewPatient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolMedUMG.View"
        mc:Ignorable="d"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="NoResize"
        Title="Informacje pacjenta"  Width="800" Height="600" WindowStartupLocation="CenterScreen">
    <Border Width="700"
        Height="500"
        Background="White"
        CornerRadius="20"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Padding="30">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5"/>
        </Border.Effect>

        <Grid>
            <!-- Close button -->
            <Button Content="✕"
                Width="30" Height="30"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                Foreground="Black"
                FontSize="16"
                Click="CloseButton_Click"/>


            <!-- Logo -->
            <Image Source="{StaticResource di_PolMedLOGO}"
         Width="60"
         Height="60"
         HorizontalAlignment="Right"
         VerticalAlignment="Top"
         Margin="0,0,30,0"/>

            <!-- Under logo -->
            <Separator HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   Margin="0,60,0,0"
                   Height="1"
                   Background="Gray"/>



            <!-- Info -->
            <Grid Height="350" Width="auto" Margin="5,80,5,10">
                <Image HorizontalAlignment="Left" Height="80" Margin="10,10,0,0" VerticalAlignment="Top" Width="80" Source="{DynamicResource di_PolMedLOGO}"/>
                <TextBlock x:Name="PatientNameText" HorizontalAlignment="Left" Margin="10,105,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                <TextBlock x:Name="PatientSurnameText" HorizontalAlignment="Left" Margin="10,125,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                <TextBlock x:Name="PatientEmailText" HorizontalAlignment="Left" Margin="10,145,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                <TextBlock x:Name="PatientPhoneNumberText" HorizontalAlignment="Left" Margin="10,165,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                <TextBlock x:Name="PatientAddressText" HorizontalAlignment="Left" Margin="10,185,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
            </Grid>
        </Grid>
    </Border>
</Window>
