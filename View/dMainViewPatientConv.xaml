<Window x:Class="PolMedUMG.View.dMainViewPatientConv"      
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
        xmlns:view="clr-namespace:PolMedUMG.View"
        mc:Ignorable="d"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown"
        Title="Konwersacja z pacjentem"  Width="925" Height="600" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <view:BoolToBackgroundConverter x:Key="BoolToBackgroundConverter" />
        <view:BoolToAlignmentConverter x:Key="BoolToAlignmentConverter" />
        <view:BoolToForegroundConverter x:Key="BoolToForegroundConverter" />
    </Window.Resources>

    <Border Width="900"
        Height="575"
        Background="White"
        CornerRadius="20"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Padding="15,15,15,10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="1"/>
        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Close button -->
            <Button Content="✕"
                Width="35" Height="35"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                Foreground="Black"
                FontSize="16"
                Click="CloseButton_Click"
                Grid.Row="0"/>


            <!-- Logo -->
            <Image Source="{StaticResource di_PolMedLOGO}"
         Width="55"
         Height="55"
         HorizontalAlignment="Right"
         VerticalAlignment="Top"
         Margin="0,0,815,0"
         Grid.Row="0"/>

            <!-- Under logo -->
            <Separator HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   Margin="0,54,0,0"
                   Height="1"
                   Background="Gray"
                   Grid.Row="0"/>

            <DockPanel 
            x:Name="RightContentPanel"
            Grid.Row="1">


                <Grid x:Name="MainArea">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border CornerRadius="20" Background="White" Margin="20,5,20,0">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="5" BlurRadius="10" Opacity="0.3"/>
                        </Border.Effect>
                        <DockPanel Grid.Row="0"  Margin="10,10,10,10" VerticalAlignment="Center" Height="50">
                            <Border CornerRadius="30,30,30,30" Width="50">
                                <Border.Background>
                                    <ImageBrush Stretch="Fill" ImageSource="/Images/Icons/profile.jpg"/>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="{Binding patientName}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="5"/>
                            <TextBlock Text="{Binding FormattedLoginDate}" FontSize="15" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="15,0,10,0"/>
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl x:Name="MessagesList" Margin="10" ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Sender, Converter={StaticResource BoolToBackgroundConverter}}" 
                    CornerRadius="15" Padding="10" Margin="0,5" 
                    HorizontalAlignment="{Binding Sender, Converter={StaticResource BoolToAlignmentConverter}}">
                                        <TextBlock Text="{Binding Content}" Foreground="{Binding Sender, Converter={StaticResource BoolToForegroundConverter}}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Input + przycisk -->
                    <DockPanel Grid.Row="2" Margin="10" >
                        <Border CornerRadius="15" Background="White">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Direction="360" ShadowDepth="5" BlurRadius="10" Opacity="0.3"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Keyboard.KeyDown="MessageInput_KeyUp" x:Name="MessageInput" BorderThickness="0" Background="Transparent" Grid.Column="0" VerticalAlignment="Center" Margin="5,0,10,0" Height="50" Width="Auto" DockPanel.Dock="Left" 
                    VerticalContentAlignment="Center" FontSize="18"/>
                                    <Button Content="wyślij" Click="Send_Click1" Grid.Column="1" Foreground="White" Height="50" Width="80" FontSize="17" HorizontalAlignment="Right">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#5C84E2"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FF2B58C3" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Width="60" Height="40" CornerRadius="15" Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Grid>

            </DockPanel>

        </Grid>
    </Border>
</Window>
