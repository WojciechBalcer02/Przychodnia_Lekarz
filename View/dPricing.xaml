<UserControl x:Class="PolMedUMG.View.dPricing" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PolMedUMG.View"
             Height="Auto" Width="Auto">

    <Grid Margin="10" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15">
            <Run Language="pl-pl" Text="Cennik"/>
        </TextBlock>

        <StackPanel Grid.Row="1">
            <!-- Headings -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Nazwa usługi" Margin="20,0,0,0" Width="80" FontWeight="Bold"/>
                <TextBlock Text="Cena usługi" Margin="400,0,0,0" Width="80" FontWeight="Bold"/>

            </StackPanel>

            <!-- Prices -->
            <ListBox x:Name="ResultsListBox"
                     Background="Transparent"
                     BorderBrush="Transparent"
                     BorderThickness="0"
                     Padding="5"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0"
                              CornerRadius="10"
                              Margin="0,5"
                              Padding="5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ServiceName}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="Black"
                                           Width="340"
                                           FontSize="16"
                                           Margin="20,0,45,0"/>
                                <TextBlock Text="{Binding ServicePrice}" 
                                    FontWeight="Bold"
                                     Foreground="Black"
                                     Margin="95,0,0,0"
                                     Width="80"
                                     HorizontalAlignment="Center"
                                     FontSize="16"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,5"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </StackPanel>

        <!-- Pages -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="◀" 
                    Width="30" Height="30" 
                    Margin="10,0" 
                    Background="Transparent" 
                    BorderBrush="Transparent"
                    Foreground="#476EFF"
                    FontSize="18"
                    Click="PrevPage_Click"/>

            <Border Background="#8093FF"
                    CornerRadius="10"
                    Padding="5,2"
                    Margin="5,0">
                <TextBlock x:Name="PageCounterText"
                           Text="1/1"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <Button Content="▶" 
                    Width="30" Height="30" 
                    Margin="10,0" 
                    Background="Transparent" 
                    BorderBrush="Transparent"
                    Foreground="#476EFF"
                    FontSize="18"
                    Click="NextPage_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
